{
  "name": "slv-visual-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend + static host for the slv_visual portfolio (Express + node:sqlite)",
  "type": "commonjs",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon --watch server server/index.js",
    "setup:admin": "node server/setup-admin.js",
    "seed": "node server/seed.js",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:schema": "wrangler d1 execute slv-visual --remote --file=worker/schema.sql",
    "cf:import": "wrangler d1 execute slv-visual --remote --file=worker/import.sql",
    "cf:tail": "wrangler tail"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "wrangler": "^4.0.0"
  }
}
